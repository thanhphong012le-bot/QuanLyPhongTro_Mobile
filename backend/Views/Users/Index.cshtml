@model IEnumerable<quanlyphongtro.Models.User>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>QUẢN LÝ THÀNH VIÊN</h5>
            <a asp-action="Create" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Thêm thành viên
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên đăng nhập</th>
                            <th>Quyền hạn</th>
                            <th>Phòng</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold text-primary">@item.Username</span>
                                    </td>
                                    <td>
                                        @if (item.Role?.ToLower() == "owner")
                                        {
                                            <span class="badge bg-danger">Chủ sở hữu (A)</span>
                                        }
                                        else if (item.Role?.ToLower() == "manager")
                                        {
                                            <span class="badge bg-info text-dark">Quản lý (B)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Người thuê (C)</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-house-door text-muted me-1"></i>
                                        @(item.Room != null ? item.Room.RoomName : "---")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                                   onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản này?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <p class="text-muted mb-0">Chưa có thành viên nào trong danh sách.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>