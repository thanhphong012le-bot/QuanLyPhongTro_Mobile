@model quanlyphongtro.Models.Invoice
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    // Tính toán số sử dụng và thành tiền
    var electricUsage = Model.ElectricNew - Model.ElectricOld;
    var waterUsage = Model.WaterNew - Model.WaterOld;
    var electricTotal = electricUsage * Model.Room.ElectricPrice;
    var waterTotal = waterUsage * Model.Room.WaterPrice;
}

<div class="container mt-4 mb-5">
    @* Nút quay lại nhanh ở phía trên *@
    <div class="mb-3 no-print">
        <a asp-action="Index" class="text-decoration-none text-muted fw-bold">
            <i class="bi bi-chevron-left"></i> QUAY LẠI DANH SÁCH
        </a>
    </div>

    <div class="card shadow-lg border-0" style="max-width: 800px; margin: auto;">
        @* Header hóa đơn *@
        <div class="card-header bg-dark text-white p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0 fw-bold">HÓA ĐƠN DỊCH VỤ</h2>
                    <p class="mb-0 text-secondary">Tháng @Model.Month Năm @Model.Year</p>
                </div>
                <div class="text-end">
                    <h4 class="text-success fw-bold">#INV-@Model.Id</h4>
                    <p class="mb-0">Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            @* Thông tin phòng & Trạng thái *@
            <div class="row mb-4">
                <div class="col-6">
                    <h5 class="text-muted border-bottom pb-2">Thông tin phòng</h5>
                    <p class="mb-1"><strong>Phòng:</strong> @Model.Room?.RoomName</p>
                    <p class="mb-1"><strong>Người thuê:</strong> @Model.Room?.TenantUsername</p>
                </div>
                <div class="col-6 text-end">
                    <h5 class="text-muted border-bottom pb-2">Trạng thái</h5>
                    @if (Model.IsPaid)
                    {
                        <span class="badge bg-success fs-6 p-2">ĐÃ THANH TOÁN</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6 p-2">CHƯA THANH TOÁN</span>
                    }
                </div>
            </div>

            @* Bảng chi tiết dịch vụ *@
            <table class="table table-bordered">
                <thead class="table-light text-center">
                    <tr>
                        <th>Hạng mục</th>
                        <th>Chỉ số (Mới - Cũ = Sử dụng)</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Tiền phòng</td>
                        <td class="text-center">-</td>
                        <td class="text-end">@Model.Room.Price.ToString("N0")</td>
                        <td class="text-end fw-bold">@Model.Room.Price.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Tiền Điện</td>
                        <td class="text-center">
                            @Model.ElectricNew - @Model.ElectricOld = @electricUsage kWh
                        </td>
                        <td class="text-end">@Model.Room.ElectricPrice.ToString("N0")</td>
                        <td class="text-end fw-bold">@electricTotal.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Tiền Nước</td>
                        <td class="text-center">
                            @Model.WaterNew - @Model.WaterOld = @waterUsage m3
                        </td>
                        <td class="text-end">@Model.Room.WaterPrice.ToString("N0")</td>
                        <td class="text-end fw-bold">@waterTotal.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Tiền Wifi</td>
                        <td class="text-center">Trọn gói</td>
                        <td class="text-end">@Model.Room.WifiPrice.ToString("N0")</td>
                        <td class="text-end fw-bold">@Model.Room.WifiPrice.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>Tiền Rác</td>
                        <td class="text-center">Cố định</td>
                        <td class="text-end">@Model.Room.TrashPrice.ToString("N0")</td>
                        <td class="text-end fw-bold">@Model.Room.TrashPrice.ToString("N0")</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="table-secondary">
                        <td colspan="3" class="text-end fw-bold fs-5">TỔNG CỘNG:</td>
                        <td class="text-end text-danger fw-bold fs-4">@Model.TotalAmount.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>

            @if ((role?.ToLower() == "user" || role?.ToLower() == "tenant") && !Model.IsPaid)
            {
                <div class="mt-5 border-top pt-4 text-center no-print">
                    <h5 class="fw-bold mb-3 text-primary">CHỌN PHƯƠNG THỨC THANH TOÁN</h5>
                    <div class="d-flex justify-content-center gap-3 mb-4">
                        <button type="button" class="btn btn-outline-primary btn-lg px-4 shadow-sm" onclick="togglePayment('transfer')">
                            📲 Chuyển khoản (QR)
                        </button>
                    </div>

                    <div id="qrSection" style="display: none;">
                        <div class="alert alert-light border shadow-sm d-inline-block p-4 mb-2">
                            <h6 class="fw-bold text-dark mb-3">QUÉT MÃ QR ĐỂ THANH TOÁN</h6>
                            @{
                                string BANK_ID = "BIDV";
                                string ACCOUNT_NO = "6503910249";
                                string ACCOUNT_NAME = "HO KINH DOANH LE THANH PHONG";
                                string DESCRIPTION = $"THANH TOAN PHONG {Model.Room.RoomName} THANG {Model.Month}";
                                string qrUrl = $"https://img.vietqr.io/image/{BANK_ID}-{ACCOUNT_NO}-compact2.png?amount={Model.TotalAmount}&addInfo={Uri.EscapeDataString(DESCRIPTION)}&accountName={Uri.EscapeDataString(ACCOUNT_NAME)}";
                            }
                            <div class="bg-white p-2 border rounded mb-2">
                                <img src="@qrUrl" alt="QR Thanh Toan" class="img-fluid" style="max-width: 250px;" />
                            </div>
                            <div class="fw-bold text-danger fs-5 mb-3">@Model.TotalAmount.ToString("N0") VNĐ</div>

                            <div class="mt-2">
                                <button type="button" class="btn btn-success btn-lg shadow-sm px-4 w-100"
                                        onclick="confirmPaymentAjax(@Model.Id)">
                                    ✅ TÔI ĐÃ CHUYỂN KHOẢN XONG
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* Nút chức năng ở dưới cùng *@
            <div class="text-center mt-5 no-print border-top pt-4">
                <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill shadow-sm">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
                <button onclick="window.print()" class="btn btn-outline-dark px-4 rounded-pill shadow-sm ms-2">
                    <i class="bi bi-printer"></i> In hóa đơn
                </button>
            </div>

            <div class="mt-4 pt-3 text-center no-print">
                <div class="alert alert-warning d-inline-block px-4 shadow-sm">
                    <i class="bi bi-info-circle"></i> Vui Lòng Liên Hệ Với Quản Lý Để Thanh Toán Bằng Tiền Mặt.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print { display: none !important; }
        .card { border: none !important; shadow: none !important; }
        .shadow-lg { box-shadow: none !important; }
    }
</style>

<script>
    function togglePayment(type) {
        var qr = document.getElementById('qrSection');
        if (type === 'transfer') {
            qr.style.display = (qr.style.display === 'none') ? 'block' : 'none';
        }
    }

    function confirmPaymentAjax(invoiceId) {
        if (confirm('Bạn chắc chắn đã chuyển khoản thành công?')) {
            fetch('/Invoices/UserConfirmAjax/' + invoiceId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Xác nhận thành công! ' + data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                console.error('Lỗi:', error);
                alert('Có lỗi xảy ra khi gửi xác nhận.');
            });
        }
    }
</script>