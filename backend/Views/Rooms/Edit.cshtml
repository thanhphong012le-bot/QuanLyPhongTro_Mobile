@model quanlyphongtro.Models.Room

@{
    ViewData["Title"] = "Chỉnh sửa phòng";
}
<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">🛠️ Chỉnh sửa thông tin: @Model.RoomName</h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                @* Giữ lại Id ẩn *@
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    @* Cột 1: Thông tin phòng *@
                    <div class="col-md-6 border-end">
                        <h4 class="text-secondary border-bottom pb-2">Thông tin cơ bản</h4>
                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Tên phòng</label>
                            <input asp-for="RoomName" class="form-control" />
                            <span asp-validation-for="RoomName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Giá thuê (VNĐ)</label>
                            <input asp-for="Price" type="number" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 form-check">
                            <label class="form-check-label mt-2">
                                <input class="form-check-input" asp-for="Status" />
                                <strong>Còn trống (Tích chọn nếu chưa có người ở)</strong>
                            </label>
                        </div>
                    </div>

                    @* Cột 2: Cấu hình dịch vụ (Điện, Nước, Rác, Wifi) *@
                    <div class="col-md-6">
                        <h4 class="text-secondary border-bottom pb-2">Đơn giá dịch vụ</h4>
                        
                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Đơn giá Điện (VNĐ/kWh)</label>
                            <input asp-for="ElectricPrice" type="number" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Đơn giá Nước (VNĐ/m3)</label>
                            <input asp-for="WaterPrice" type="number" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Tiền Rác (VNĐ/tháng)</label>
                            <input asp-for="TrashPrice" type="number" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label fw-bold">Tiền Wifi (VNĐ/tháng)</label>
                            <div class="input-group">
                                <div class="input-group-text">
                                    @* Giả sử bạn có thuộc tính bool HasWifi trong Model để bật/tắt *@
                                    <input class="form-check-input mt-0" asp-for="HasWifi" type="checkbox">
                                        <span class="ms-2">Sử dụng</span>
                                    </div>
                                    <input asp-for="WifiPrice" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow">💾 Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg px-5 shadow">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }