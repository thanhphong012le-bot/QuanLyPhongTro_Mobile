@model IEnumerable<quanlyphongtro.Models.Room>
@using Microsoft.AspNetCore.Http
@{
    // Lấy Role từ Session và ép về chữ thường để so sánh không sai lệch
    var role = Context.Session.GetString("Role")?.ToLower();
}

<div class="container-fluid mt-4 px-5">
    @* 1. THÔNG BÁO SAU KHI THAO TÁC *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="msgAlert" class="alert alert-success alert-dismissible fade show shadow" role="alert">
            <strong class="fs-4">✅ @TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <script>
                setTimeout(function () {
                    var element = document.getElementById("msgAlert");
                    if (element) {
                        var bsAlert = new bootstrap.Alert(element);
                        bsAlert.close();
                    }
                }, 3000);
        </script>
    }

    @* 2. TIÊU ĐỀ VÀ NÚT TẠO MỚI *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-primary">🏠 Quản lý danh sách phòng</h1>
        @* Sửa thành chữ thường "owner" *@
        @if (role == "owner")
        {
            <div class="text-end">
                <a asp-action="Create" class="btn btn-success shadow fs-4 px-4 py-2">➕ Tạo phòng mới</a>
            </div>
        }
    </div>

    @* 3. BẢNG DANH SÁCH *@
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm" style="font-size: 1.2rem;">
            <thead class="table-dark text-center">
                <tr>
                    <th style="padding: 20px;">Tên phòng</th>
                    <th style="padding: 20px;">Giá tiền (VNĐ)</th>
                    <th style="padding: 20px;">Trạng thái</th>
                    <th style="padding: 20px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold align-middle" style="font-size: 1.4rem;">@item.RoomName</td>
                        <td class="text-end pe-4 text-primary fw-bold align-middle">@item.Price.ToString("N0")</td>
                        <td class="text-center align-middle">
                            @if (item.Status)
                            {
                                <span class="badge bg-success p-2" style="font-size: 1rem;">Còn trống</span>
                            }
                            else
                            {
                                <span class="badge bg-danger p-2" style="font-size: 1rem;">Đã thuê</span>
                            }
                        </td>
                        <td class="text-center align-middle">
                            <div class="btn-group">
                                @* CHI TIẾT: AI CŨNG XEM ĐƯỢC *@
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-lg text-white">Chi tiết</a>

                                @* SỬA & GHI ĐIỆN NƯỚC: OWNER VÀ MANAGER (Dùng chữ thường) *@
                                @if (role == "owner" || role == "manager")
                                {
                                    @* NÚT GHI ĐIỆN NƯỚC: Chỉ hiện khi phòng ĐÃ THUÊ *@
                                    @if (!item.Status)
                                    {
                                        <a asp-controller="Invoices"
                                           asp-action="Create"
                                           asp-route-roomId="@item.Id"
                                           class="btn btn-warning btn-lg text-dark fw-bold">⚡ Ghi điện nước</a>
                                    }
                                    
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-lg">Sửa</a>
                                }

                                @* XÓA: CHỈ OWNER MỚI CÓ QUYỀN *@
                                @if (role == "owner")
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-lg"
                                       onclick="return confirm('Xác nhận xóa phòng @item.RoomName?')">Xóa</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>